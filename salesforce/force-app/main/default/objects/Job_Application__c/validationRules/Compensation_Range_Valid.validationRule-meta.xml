<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Compensation_Range_Valid</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Compensation_Minimum__c)),
    NOT(ISBLANK(Compensation_Maximum__c)),
    Compensation_Maximum__c &lt; Compensation_Minimum__c
)</errorConditionFormula>
    <errorDisplayField>Compensation_Minimum__c</errorDisplayField>
    <errorMessage>Compensation Maximum must be greater than or equal to Compensation Minimum.</errorMessage>
</ValidationRule>
