<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Compensation_Cannot_Be_Negative</fullName>
    <active>true</active>
    <errorConditionFormula>OR(
    Compensation_Minimum__c &lt; 0,
    Compensation_Maximum__c &lt; 0
)</errorConditionFormula>
    <errorMessage>Compensation amounts cannot be negative.</errorMessage>
</ValidationRule>
