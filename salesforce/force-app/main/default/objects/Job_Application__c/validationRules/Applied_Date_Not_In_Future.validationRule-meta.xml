<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Applied_Date_Not_In_Future</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    NOT(ISBLANK(Applied_Date__c)),
    Applied_Date__c &gt; TODAY()
)</errorConditionFormula>
    <errorDisplayField>Applied_Date__c</errorDisplayField>
    <errorMessage>Applied Date cannot be in the future.</errorMessage>
</ValidationRule>
