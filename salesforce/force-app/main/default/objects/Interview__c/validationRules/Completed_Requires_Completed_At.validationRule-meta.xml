<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Completed_Requires_Completed_At</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Status__c, &quot;Completed&quot;),
    ISBLANK(Completed_At__c)
)</errorConditionFormula>
    <errorDisplayField>Completed_At__c</errorDisplayField>
    <errorMessage>Enter Completed At before marking this interview Completed.</errorMessage>
</ValidationRule>
