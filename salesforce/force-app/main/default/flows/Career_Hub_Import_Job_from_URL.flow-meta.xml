<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <actionCalls>
        <name>Preview_Job_Posting</name>
        <label>Preview Job Posting</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <actionName>CareerHubJobPostingPreview</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Check_Preview_Result</targetReference>
        </connector>
        <flowTransactionModel>Automatic</flowTransactionModel>
        <inputParameters>
            <name>postingUrl</name>
            <value>
                <elementReference>Employer_Posting_URL.value</elementReference>
                <inputConfiguratorMode>Resource</inputConfiguratorMode>
            </value>
        </inputParameters>
        <nameSegment>CareerHubJobPostingPreview</nameSegment>
        <offset>0</offset>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </actionCalls>
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <customProperties>
        <name>ScreenProgressIndicator</name>
        <value>
            <stringValue>{&quot;location&quot;:&quot;top&quot;,&quot;type&quot;:&quot;simple&quot;}</stringValue>
        </value>
    </customProperties>
    <decisions>
        <name>Check_Preview_Result</name>
        <label>Check Preview Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Unsupported_Posting</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Unsupported Posting</defaultConnectorLabel>
        <rules>
            <name>Already_Exists</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Preview_Job_Posting.status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>DUPLICATE</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Get_Existing_Application</targetReference>
            </connector>
            <label>Already_Exists</label>
        </rules>
        <rules>
            <name>Review_Details</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Preview_Job_Posting.status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>READY</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Preview_Job_Posting.status</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>MANUAL</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Review_Job_Details</targetReference>
            </connector>
            <label>Review_Details</label>
        </rules>
    </decisions>
    <decisions>
        <name>Duplicate_Before_Save</name>
        <label>Duplicate Before Save</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Create_Job_Application</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Clear to Save</defaultConnectorLabel>
        <rules>
            <name>Duplicate_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Find_Existing_Application</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <isGoTo>true</isGoTo>
                <targetReference>Get_Existing_Application</targetReference>
            </connector>
            <label>Duplicate Found</label>
        </rules>
    </decisions>
    <dynamicChoiceSets>
        <name>Job_Source_Choices</name>
        <dataType>Picklist</dataType>
        <displayField xsi:nil="true"/>
        <object xsi:nil="true"/>
        <picklistField>Job_Source__c</picklistField>
        <picklistObject>Job_Application__c</picklistObject>
    </dynamicChoiceSets>
    <environments>Default</environments>
    <formulas>
        <name>Existing_Application_Id</name>
        <dataType>String</dataType>
        <expression>IF(ISBLANK({!Preview_Job_Posting.existingApplicationId}), {!Find_Existing_Application.Id}, {!Preview_Job_Posting.existingApplicationId})</expression>
    </formulas>
    <formulas>
        <name>Is_LinkedIn_Posting</name>
        <dataType>Boolean</dataType>
        <expression>BEGINS({!Preview_Job_Posting.sourceJobKey}, &quot;linkedin:&quot;)</expression>
    </formulas>
    <formulas>
        <name>Resolved_Job_Source</name>
        <dataType>String</dataType>
        <expression>IF({!Is_LinkedIn_Posting}, &quot;LinkedIn&quot;, {!Job_Source_Input})</expression>
    </formulas>
    <interviewLabel>Career Hub – Import Job from URL {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Career Hub – Import Job from URL</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>Flow</processType>
    <recordCreates>
        <name>Create_Job_Application</name>
        <label>Create Job Application</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <inputAssignments>
            <field>Employer__c</field>
            <value>
                <elementReference>Employer.recordId</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Job_Description__c</field>
            <value>
                <elementReference>Review_Job_Description</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Job_Source__c</field>
            <value>
                <elementReference>Resolved_Job_Source</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Job_Title__c</field>
            <value>
                <elementReference>Review_Job_Title</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Location__c</field>
            <value>
                <elementReference>Review_Location</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Posting_URL__c</field>
            <value>
                <elementReference>Preview_Job_Posting.canonicalUrl</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Source_Job_Key__c</field>
            <value>
                <elementReference>Preview_Job_Posting.sourceJobKey</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Stage__c</field>
            <value>
                <stringValue>Discovered</stringValue>
            </value>
        </inputAssignments>
        <object>Job_Application__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordCreates>
    <recordLookups>
        <name>Find_Existing_Application</name>
        <label>Find Existing Application</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Duplicate_Before_Save</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Source_Job_Key__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Preview_Job_Posting.sourceJobKey</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Job_Application__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordLookups>
        <name>Get_Existing_Application</name>
        <label>Get Existing Application</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Already_in_Career_Hub</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Existing_Application_Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>Job_Application__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
